{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install Upstream (Radare2 / Rizin / Shuriken / Ares)",
            "type": "shell",
            "command": "sh",
            "args": [
                ".devcontainer/[0-9][0-9][0-9]_setup${input:upstream}.sh"
            ]
        },
        {
            "label": "Install Quark & PyPi Dependencies",
            "type": "shell",
            "command": "sh",
            "args": [
                ".devcontainer/010_setupQuark.sh"
            ]
        },
        {
            "label": "Install Helping Tools",
            "type": "shell",
            "command": "sh",
            "args": [
                ".devcontainer/009_setupHelpingTools.sh"
            ]
        }
    ],
    "inputs": [
			{
				"id": "upstream",
				"type": "pickString",
				"description": "Pick an upstream",
				"options": [
                    "Rizin",
                    "Ares",
                    "Radare2",
                    "Shuriken"
                ]
            }
        ]
}